{
  "name": "gully-foam-war",
  "productName": "Gully Foam War",
  "version": "1.0.0",
  "description": "First-person foam, paintball and airsoft blaster game",
  "main": "electron/main.js",
  "author": "Matthew Lynn",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "pack:win": "electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.hepmatt.gullyfoamwar",
    "productName": "Gully Foam War",
    "copyright": "Copyright © 2026 Matthew Lynn",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "fonts/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gully Foam War",
      "artifactName": "GullyFoamWar-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "GullyFoamWar-${version}-portable.exe"
    }
  }
}
